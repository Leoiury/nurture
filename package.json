{
  "name": "nurture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "node scripts/gerar-tipos.mjs",
    "importar:legado": "node --env-file=.env.local scripts/importar-legado.mts",
    "usuario:criar": "node --env-file=.env.local scripts/criar-usuario.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "supabase start && node scripts/ambiente-local.mjs",
    "db:local:reset": "supabase db reset && node scripts/ambiente-local.mjs",
    "db:local:parar": "supabase stop",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "docx": "9.15.1",
    "exceljs": "^4.4.0",
    "next": "16.4.4",
    "pdfmake": "0.3.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jszip": "3.10.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
